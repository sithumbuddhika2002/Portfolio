{
    "headers": [
        {
            "source": "/admin/:path*",
            "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
        },
        {
            "source": "/slingshot-lamp/:path*",
            "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
